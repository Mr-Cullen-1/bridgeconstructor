{
  "name": "bridge-master",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "export:lms": "node scripts/export-lms.mjs && node scripts/check-lms.mjs",
    "check:lms": "node scripts/check-lms.mjs",
    "test:lms": "npm run export:lms && playwright test --config playwright.lms.config.js",
    "preview:lms": "node scripts/serve-lms-preview.mjs",
    "export:gamelab": "node scripts/export-gamelab.mjs && node scripts/check-gamelab.mjs",
    "check:gamelab": "node scripts/check-gamelab.mjs",
    "test:gamelab": "npm run export:gamelab && playwright test --project=gamelab"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "rolldown": "1.2.19",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
